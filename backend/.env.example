APP_ENV=dev
SQLITE_PATH=data/nero.db
MODEL_PATH=models/isolation_forest.joblib
RANDOM_SEED=42
CORS_ORIGINS=http://localhost:5173
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Gemini powers the investigation chat + summary (data-grounded). Leave blank
# to use the deterministic fallback that answers only from the analysis data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tariff used to value estimated unbilled energy (EUR per kWh).
TARIFF_EUR_PER_KWH=0.14
